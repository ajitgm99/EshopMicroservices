using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Net;
using System.Net.Http;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.Logging;

public class JsonFetcher : IJsonFetcher, IDisposable
{
    private readonly HttpClient _httpClient;
    private readonly ILogger<JsonFetcher> _logger;
    private readonly FetcherOptions _options;
    private readonly SemaphoreSlim _rateLimiter;

    public JsonFetcher(FetcherOptions options, ILogger<JsonFetcher> logger = null)
    {
        _options = options;
        _logger = logger;
        
        var handler = new SocketsHttpHandler
        {
            PooledConnectionLifetime = TimeSpan.FromMinutes(5),
            PooledConnectionIdleTimeout = TimeSpan.FromMinutes(1),
            MaxConnectionsPerServer = options.MaxDegreeOfParallelism * 2
        };

        _httpClient = new HttpClient(handler)
        {
            Timeout = TimeSpan.FromSeconds(30)
        };

        if (options.UseHttp2)
        {
            _httpClient.DefaultRequestVersion = HttpVersion.Version20;
        }

        _rateLimiter = new SemaphoreSlim(options.MaxDegreeOfParallelism, options.MaxDegreeOfParallelism);
    }

    public async Task<ConcurrentBag<T>> FetchAllAsync<T>(IEnumerable<RequestConfig> requests)
    {
        var results = new ConcurrentBag<T>();
        
        await Parallel.ForEachAsync(requests, new ParallelOptions
        {
            MaxDegreeOfParallelism = _options.MaxDegreeOfParallelism
        }, async (request, cancellationToken) =>
        {
            try
            {
                await _rateLimiter.WaitAsync(cancellationToken);
                try
                {
                    if (_options.RateLimitDelay > TimeSpan.Zero)
                    {
                        await Task.Delay(_options.RateLimitDelay, cancellationToken);
                    }

                    var result = await FetchWithRetryAsync<T>(request, cancellationToken);
                    if (result != null)
                    {
                        results.Add(result);
                    }
                }
                finally
                {
                    _rateLimiter.Release();
                }
            }
            catch (Exception ex)
            {
                _logger?.LogError(ex, "Error processing request for {Url}", request.Url);
            }
        });

        return results;
    }

    public async IAsyncEnumerable<T> FetchAllStreamingAsync<T>(IEnumerable<RequestConfig> requests)
    {
        var queue = new ConcurrentQueue<T>();
        
        await Parallel.ForEachAsync(requests, new ParallelOptions
        {
            MaxDegreeOfParallelism = _options.MaxDegreeOfParallelism
        }, async (request, cancellationToken) =>
        {
            try
            {
                await _rateLimiter.WaitAsync(cancellationToken);
                try
                {
                    if (_options.RateLimitDelay > TimeSpan.Zero)
                    {
                        await Task.Delay(_options.RateLimitDelay, cancellationToken);
                    }

                    var result = await FetchWithRetryAsync<T>(request, cancellationToken);
                    if (result != null)
                    {
                        queue.Enqueue(result);
                    }
                }
                finally
                {
                    _rateLimiter.Release();
                }
            }
            catch (Exception ex)
            {
                _logger?.LogError(ex, "Error processing request for {Url}", request.Url);
            }
        });

        while (queue.TryDequeue(out var item))
        {
            yield return item;
        }
    }

    private async Task<T> FetchWithRetryAsync<T>(RequestConfig request, CancellationToken cancellationToken)
    {
        int attempt = 0;
        while (true)
        {
            try
            {
                return await FetchSingleAsync<T>(request, cancellationToken);
            }
            catch (Exception ex) when (attempt < _options.MaxRetryAttempts)
            {
                attempt++;
                _logger?.LogWarning(ex, "Attempt {Attempt} failed for {Url}. Retrying...", attempt, request.Url);
                await Task.Delay(_options.RetryDelay, cancellationToken);
            }
            catch (Exception ex)
            {
                _logger?.LogError(ex, "All attempts failed for {Url}", request.Url);
                throw;
            }
        }
    }

    private async Task<T> FetchSingleAsync<T>(RequestConfig request, CancellationToken cancellationToken)
    {
        using var requestMessage = new HttpRequestMessage(HttpMethod.Get, request.Url);
        
        if (!string.IsNullOrEmpty(request.AuthToken))
        {
            requestMessage.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", request.AuthToken);
        }

        foreach (var header in request.Headers)
        {
            requestMessage.Headers.Add(header.Key, header.Value);
        }

        using var response = await _httpClient.SendAsync(
            requestMessage, 
            HttpCompletionOption.ResponseHeadersRead, 
            cancellationToken);

        response.EnsureSuccessStatusCode();

        await using var stream = await response.Content.ReadAsStreamAsync(cancellationToken);
        return await JsonSerializer.DeserializeAsync<T>(stream, cancellationToken: cancellationToken);
    }

    public void Dispose()
    {
        _httpClient?.Dispose();
        _rateLimiter?.Dispose();
    }
}
