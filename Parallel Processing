using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using ParallelJsonFetcher.Core.Models;
using ParallelJsonFetcher.Core.Services;
using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Threading.Tasks;

class Program
{
    static async Task Main(string[] args)
    {
        var host = Host.CreateDefaultBuilder(args)
            .ConfigureServices((context, services) =>
            {
                services.AddTransient<IJsonFetcher, JsonFetcher>();
                services.Configure<FetcherOptions>(context.Configuration.GetSection("FetcherOptions"));
            })
            .Build();

        var logger = host.Services.GetRequiredService<ILogger<Program>>();
        var fetcher = host.Services.GetRequiredService<IJsonFetcher>();

        try
        {
            // Generate sample requests with auth tokens
            var requests = GenerateRequests(10000, "your-auth-token-here");

            logger.LogInformation("Starting parallel fetch operation...");
            
            // Option 1: Get all results at once
            var results = await fetcher.FetchAllAsync<YourDataModel>(requests);
            
            // Option 2: Process results as they come (better for memory)
            // await foreach (var result in fetcher.FetchAllStreamingAsync<YourDataModel>(requests))
            // {
            //     ProcessResult(result);
            // }
            
            logger.LogInformation("Completed. Fetched {Count} items", results.Count);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "An error occurred during processing");
        }
    }

    private static IEnumerable<RequestConfig> GenerateRequests(int count, string authToken)
    {
        for (int i = 0; i < count; i++)
        {
            yield return new RequestConfig
            {
                Url = $"https://api.example.com/data/{i}",
                AuthToken = authToken,
                Headers = new Dictionary<string, string>
                {
                    ["X-Custom-Header"] = "Value"
                }
            };
        }
    }
}
